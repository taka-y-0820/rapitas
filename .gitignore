# Analysis reports (auto-generated)
analysis-report.md
analysis-result.json

# Git worktrees for parallel agent execution
.worktrees/

# Agent transient workflow files — written then curl'd to the workflow/concern/
# idea APIs (.wf-tmp.md, .wf-concern.json, .wf-idea.json). Ignored repo-wide so
# they never appear in any git diff/status/add or the changed-file list.
#
# The hyphen was load-bearing and should not have been: task 674 wrote
# `.wf674.json`, which matched nothing here, was committed as an unplanned
# artifact, and the diff review cut the task off for scope creep — the only
# change in that diff was the stray file. Match the prefix, not one spelling
# of it.
.wf-*
.wf[0-9]*
# Agent PID files. agent-process-tracker writes them under process.cwd(),
# which is the worktree ROOT when the CLI runs there — the rapitas-backend/
# ignore never applies, and auto-commit's `git add -A` swept two of them into
# task 710's diff (bounced by the diff review as unplanned artifacts).
.agent-pids/

# Memory system vector DB
rapitas-backend/data/
# Stray lockfiles (each subproject owns its own; see ADR-0001)
pnpm-lock.yaml
rapitas-frontend/bun.lock
rapitas-desktop/bun.lock

rapitas-desktop/.data/

# Full command output from scripts/run-checked.cjs (task 916) — console only
# shows a tail, the complete log lives here for later inspection.
.verification-logs/
