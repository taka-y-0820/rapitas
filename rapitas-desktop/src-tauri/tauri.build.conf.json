{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../public"
  },
  "app": {
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "linux": {
      "rpm": { "compression": { "type": "zstd", "level": 3 } }
    },
    "targets": ["deb", "rpm", "nsis", "msi", "dmg", "app"],
    "externalBin": [],
    "resources": [
      "binaries/rapitas-backend-*.exe",
      "binaries/rapitas-backend-*",
      "binaries/*query_engine*"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
