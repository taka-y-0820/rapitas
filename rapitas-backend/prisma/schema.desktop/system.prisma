model Notification {
  id                Int       @id @default(autoincrement())
  type              String
  title             String
  message           String
  link              String?
  isRead            Boolean   @default(false)
  readAt            DateTime?
  metadata          String?   // JSON stored as string
  createdAt         DateTime  @default(now())
}

// Lightweight memo (quick-capture メモモード): a thing to remember or a tiny
// record — deliberately smaller than the Notes feature (documents, tags, AI).
// An optional one-shot reminder is delivered through the Notification pipeline
// by services/scheduling/memo-reminder-scheduler.ts.
model Memo {
  id         Int       @id @default(autoincrement())
  content    String
  remindAt   DateTime? // when to notify; null = plain memo
  remindedAt DateTime? // set once the reminder notification fired (one-shot)
  isDone     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([remindAt])
}

model UserSettings {
  id                          Int       @id @default(autoincrement())
  developerModeDefault        Boolean   @default(false)
  aiTaskAnalysisDefault       Boolean   @default(false)
  autoResumeInterruptedTasks  Boolean   @default(false)
  autoExecuteAfterCreate      Boolean   @default(false)
  autoGenerateTitle           Boolean   @default(false)
  autoGenerateTitleDelay      Int       @default(3)       // Wait time in seconds before auto-generating title
  autoCreateAfterTitleGeneration Boolean @default(false) // Auto-create after title generation
  autoFetchTaskSuggestions    Boolean   @default(true)  // Auto-fetch AI suggestions when theme is selected
  defaultCategoryId           Int?      // Default selected category
  activeMode                  String    @default("both") // "development", "learning", "both"
  claudeApiKeyEncrypted       String?
  chatgptApiKeyEncrypted      String?
  geminiApiKeyEncrypted       String?
  claudeDefaultModel          String?
  chatgptDefaultModel         String?
  geminiDefaultModel          String?
  ollamaUrl                   String?   @default("http://localhost:11434")
  ollamaDefaultModel          String?   @default("gemma3:4b")
  titleGenerationProvider     String?   @default("ollama") // Title generation provider (ollama=local free AI)
  defaultAiProvider           String?   @default("claude")
  autoApprovePlan             Boolean   @default(false) // Whether to auto-approve when saving plan.md
  autoApproveSubtaskPlan      Boolean   @default(true)  // Auto-approve subtask plan.md (default ON)
  autoComplexityAnalysis      Boolean   @default(false) // Whether to enable automatic complexity analysis
  // Global off-switch for the multi-phase workflow (research/plan/verify as
  // separate saved artifacts + phase-critic gate). When true, new task
  // executions skip straight to a single direct-implementation pass (still
  // gated by lint/test verification, adversarial diff review, and the
  // completion gate — only the phase ceremony is skipped). A per-task
  // Task.workflowDisabled flag can additionally opt a single task in/out.
  workflowDisabledGlobally    Boolean   @default(false)
  // Max concurrent auto-created backlog tasks PER THEME. 0 = disabled (opt-in).
  // When a theme's auto-run runs out of work it promotes open concerns (then
  // ideas once concerns are clear) into tasks up to this cap. See backlog-task-promoter.
  autoCreateFromBacklogLimit  Int       @default(0)
  // Dev: when auto-run runs dry (no live agents), restart the backend to pick up
  // committed fixes before creating more tasks. Gated by HEAD-moved + no-agents +
  // rate-limit in dev-restart-on-dry.ts. Only effective under dev.js (exit 75).
  restartOnAutoRunDry         Boolean   @default(false)
  // Max verify->implement self-repair cycles before a task is blocked. The
  // verifier's failure is fed back to the implementer to fix and re-verify, up
  // to this many times. 0 disables auto-repair. See verify-self-repair.ts.
  verifyRepairLimit           Int       @default(2)
  // Minutes of no-progress before a task is flagged stalled on the execution
  // dashboard (default 5). UI-display threshold only; does NOT affect the
  // existing automatic-intervention thresholds in queue-stall-policy.ts. See
  // execution-dashboard-service.ts / task 870.
  executionStallThresholdMinutes Int    @default(5)
  // Idle-stop timer (task 784): once a theme's auto-run runs dry (queue and
  // active executions empty) and NO new task is filed for this many minutes,
  // auto-run is stopped (ThemeAutoRun.enabled=false) with a notification.
  // 0 disables the timer. See auto-run-idle-timer.ts / auto-run-lifecycle.ts.
  idleStopMinutes             Int       @default(60)
  // Nightly self-refill window (task 784): backlog self-refill (concerns/ideas
  // -> tasks) runs at most once per day, not before this local "HH:MM". Empty
  // string disables self-refill entirely. See backlog-task-promoter.ts.
  selfRefillWindowStart       String    @default("03:00")
  // Global automation defaults (task-level overrides win, then these, then env).
  autoCommitDefault           Boolean   @default(false) // Default: auto-commit on completion
  autoCreatePRDefault         Boolean   @default(false) // Default: auto-create PR on completion
  autoMergePRDefault          Boolean   @default(false) // Default: auto-merge PR once CI passes
  mergeCommitThresholdDefault Int       @default(5)     // Commits >= this => squash merge
  slackWebhookUrl             String?   // Slack Incoming Webhook URL for notifications
  discordWebhookUrl           String?   // Discord Webhook URL for notifications
  /**
   * When true, the rapitas runtime spawns CLI agents with their permission-bypass
   * flags (claude `--dangerously-skip-permissions` / `--permission-mode
   * bypassPermissions`, codex/gemini `--yolo`) so the agent never stops mid-
   * execution to ask the user "may I edit this file / run this command?".
   * Defaults to true to preserve the hardcoded behaviour the codebase used
   * before this setting existed.
   */
  skipAgentPermissionPrompts  Boolean   @default(true)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
}

/**
 * BacklogSchedule
 *
 * Per-job timing config for the backlog's periodic AI jobs (innovation session
 * for the idea box; vulnerability/bug scan for the concern backlog). One row per
 * `kind`. `lastRunAt` is persisted so the once-per-day guard survives restarts.
 */
model BacklogSchedule {
  id         Int       @id @default(autoincrement())
  kind       String    @unique // 'innovation' | 'vuln_scan'
  enabled    Boolean   @default(false)
  frequency  String    @default("weekly") // 'daily' | 'weekly'
  hour       Int       @default(3) // 0-23, local hour the job fires
  weekday    Int       @default(1) // 0-6 (Sun-Sat); used when frequency='weekly'
  lastRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

/**
 * ThemeBacklogSchedule
 *
 * Per-theme (per-project) override of a backlog job. Absence of a row means the
 * job's global default applies. Holds only the per-theme bits: `enabled` (e.g.
 * exclude a project from vuln_scan/innovation) and, for health_check, where and
 * how to read that project's logs (`logDir` + `logFormat`). Scheduling timing
 * stays global on BacklogSchedule. `themeId` is a plain id (no relation) to keep
 * the Theme model untouched.
 */
model ThemeBacklogSchedule {
  id         Int      @id @default(autoincrement())
  kind       String   // 'innovation' | 'vuln_scan' | 'health_check'
  themeId    Int
  enabled    Boolean  @default(true)
  logDir     String?  // health_check: directory to scan for this project's logs
  logFormat  String?  // health_check: 'pino' | 'json' | 'text'
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([kind, themeId])
}

// User authentication system
model User {
  id                Int       @id @default(autoincrement())
  username          String    @unique
  email             String?   @unique
  passwordHash      String?   // bcrypt hashed password (null for Google OAuth)
  displayName       String?
  role              String    @default("user") // admin, user
  isActive          Boolean   @default(true)
  emailVerified     Boolean   @default(false)
  lastLoginAt       DateTime?
  passwordResetToken String?
  passwordResetExpiresAt DateTime?
  // Google OAuth related fields
  provider          String    @default("local") // "local" or "google"
  providerId        String?   // Google User ID
  googleId          String?   @unique // Google-specific user ID
  avatar            String?   // Profile image URL
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sessions          UserSession[]

  @@index([username])
  @@index([email])
  @@index([googleId])
}

// User session management (JWT Token management)
model UserSession {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken    String    @unique // JWT token or session identifier
  refreshToken    String?   @unique // Refresh token
  expiresAt       DateTime  // Session expiration
  lastAccessedAt  DateTime  @default(now())
  ipAddress       String?
  userAgent       String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([sessionToken])
  @@index([expiresAt])
}

/**
 * SearchMiss
 *
 * 探索→発見→創造→再探索ループを支えるゼロ件検索の記録。
 * 検索してもヒットしなかったクエリを蓄積し、不足コンテンツの発見とタスク提案に活用する。
 */
model SearchMiss {
  id                  Int       @id @default(autoincrement())
  query               String    @unique
  hitCount            Int       @default(0)
  lastSearchedAt      DateTime  @default(now())
  status              String    @default("open")
  suggestedTaskId     Int?
  themeId             Int?
  resolvedAt          DateTime?
  resolvedResultCount Int?
  createdAt           DateTime  @default(now())

  @@index([status])
  @@index([hitCount])
  @@index([themeId])
}
