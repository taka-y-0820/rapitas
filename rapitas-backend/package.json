{
  "name": "rapitas-backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "pretest": "node scripts/check-test-isolation.cjs",
    "pretest:ci": "node scripts/check-test-isolation.cjs",
    "dev": "bun run scripts/dev.ts",
    "dev:simple": "bun --watch index.ts",
    "dev:stable": "bun server-entry.ts",
    "start": "bun run scripts/start.ts",
    "start:simple": "bun index.ts",
    "test": "bun test --isolate",
    "test:parallel": "bun scripts/parallel-test.ts",
    "test:timing": "bun scripts/test-timing.ts",
    "test:shuffle": "bun scripts/shuffle-test.ts",
    "test:full": "bun test --isolate",
    "test:integration": "bun test --path-ignore-patterns=\"\" ./tests/integration/",
    "test:all": "bun test --isolate && bun test --path-ignore-patterns=\"\" ./tests/integration/",
    "test:watch": "bun test --watch",
    "test:sqlite": "bun scripts/run-gate.ts sqlite-tests",
    "test:ci": "bun scripts/run-gate.ts backend-tests",
    "test:coverage": "bun test --coverage --isolate",
    "check:guards": "bun run scripts/check-critical-guards.ts",
    "check:ssot": "bun run scripts/check-ssot-drift.ts --check",
    "check:docs": "bun run scripts/check-docs-health.ts",
    "check:docs:strict": "bun run scripts/check-docs-health.ts --check",
    "check:docs:phase1": "bun run scripts/check-docs-health.ts --phase=1",
    "check:docs:phase2": "bun run scripts/check-docs-health.ts --phase=2",
    "eval:gates": "bun run scripts/eval-gates.ts",
    "eval:judge": "bun run scripts/eval-judge.ts",
    "eval:phase-critic": "bun run scripts/eval-phase-critic.ts",
    "generate:route-barrels": "node scripts/generate-route-barrels.cjs",
    "generate:route-barrels:check": "node scripts/generate-route-barrels.cjs --check",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:generate:sqlite": "bun run scripts/generate-sqlite-prisma-schema.cjs && prisma generate --schema prisma/schema.desktop",
    "db:prepare:sqlite": "bun run scripts/generate-sqlite-init-sql.cjs && prisma generate --schema prisma/schema.desktop",
    "db:migrate:desktop": "bun run scripts/migrate-postgres-to-sqlite.ts",
    "db:studio": "prisma studio",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.ts\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.ts\" --ignore-path .gitignore",
    "e2e": "bun run scripts/restart-loop-smoke.ts",
    "test:e2e": "bun run scripts/restart-loop-smoke.ts",
    "codemod:response": "bun run scripts/codemods/response-helper.ts",
    "codemod:spec-array": "bun run scripts/codemods/spec-array.ts",
    "codemod:prisma": "bun run scripts/codemods/prisma-singleton.ts",
    "codemod:insensitive-spread": "bun run scripts/codemods/insensitive-spread.ts",
    "codemod:test-each": "bun run scripts/codemods/prefer-test-each.ts",
    "codemod:all": "bun run scripts/codemods/response-helper.ts && bun run scripts/codemods/spec-array.ts && bun run scripts/codemods/prisma-singleton.ts && bun run scripts/codemods/insensitive-spread.ts",
    "gen:shutdown-error": "bun run scripts/gen-shutdown-error-artifacts.ts",
    "gen:type-guards": "bun run scripts/gen-type-guards.ts",
    "check:type-guards": "bun run gen:type-guards --check",
    "check:type-guards:changed": "bun run gen:type-guards --check --files",
    "gen:boundary-tests": "bun run scripts/gen-resolver-boundary-tests.ts",
    "check:boundary-tests": "bun run gen:boundary-tests --check",
    "check:boundary-tests:changed": "bun run gen:boundary-tests --check --files",
    "gen:boundary-guide": "bun run scripts/gen-boundary-guide.ts",
    "check:boundary-guide": "bun run gen:boundary-guide --check",
    "check:boundary-guide:changed": "bun run gen:boundary-guide --check --files",
    "determinism:check": "node scripts/check-determinism.cjs"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.3.13",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "prisma": "^6.19.3",
    "sharp": "^0.35.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@google/generative-ai": "^0.24.1",
    "@napi-rs/keyring": "^1.3.0",
    "@prisma/client": "^6.19.3",
    "@sentry/bun": "^10.51.0",
    "@sinclair/typebox": "0.34.15",
    "@types/ws": "^8.18.1",
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "elysia": "^1.4.28",
    "file-type": "^22.0.1",
    "googleapis": "^171.4.0",
    "ioredis": "^5.10.1",
    "lru-cache": "^11.3.5",
    "openai": "^6.35.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.59.1",
    "playwright-core": "^1.61.1",
    "ts-fsrs": "^5.3.2",
    "ws": "^8.20.0"
  },
  "trustedDependencies": [
    "protobufjs"
  ],
  "overrides": {
    "sharp": "^0.35.0",
    "protobufjs": "^7.5.8",
    "defu": "^6.1.5",
    "minimatch": "^9.0.7",
    "flatted": "^3.4.0",
    "picomatch": "^4.0.4",
    "ws": "^8.21.0",
    "brace-expansion": "^2.1.3",
    "qs": "^6.15.2",
    "file-type": "^22.0.1",
    "@opentelemetry/core": "^2.8.0"
  }
}
